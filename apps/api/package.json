{
  "name": "@controlizze/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --experimental-strip-types --watch --no-warnings src/http/server.ts",
    "start": "node --env-file=.env --experimental-strip-types --no-warnings src/http/server.ts",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env --experimental-strip-types --no-warnings src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "dotenv -e .env.test -- vitest",
    "test:unit": "dotenv -e .env.test -- vitest run --testPathPattern=unit",
    "test:integration": "dotenv -e .env.test -- vitest run --testPathPattern=integration",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "db:studio:test": "dotenv -e .env.test -- drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.52.6",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "resend": "^6.12.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@controlizze/rbac": "workspace:*",
    "@controlizze/tsconfig": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
